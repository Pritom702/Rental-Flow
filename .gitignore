# Dependencies
node_modules/
**/node_modules/

# Env files (contain secrets)
.env
.env.*

# Build output
client/dist/
dist/
build/
.vite/

# Uploaded product images (keep the folder, ignore the files)
server/uploads/*
!server/uploads/.gitkeep

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
coverage/
__pycache__/

# Large media (demo recordings — keep out of git, share via Drive)
*.mp4
*.mov

# Local scratch / staging folders (not part of the app)
_github_upload/
pagestofix/
Errors/
