{
  "name": "rentalflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "RentalFlow — equipment rental marketplace (CSE470). Root manifest used by Vercel to build the client and bundle the API function.",
  "scripts": {
    "build": "npm --prefix client install && npm --prefix client run build",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "test": "npm --prefix server test",
    "db:init": "npm --prefix server run db:init",
    "db:seed": "npm --prefix server run db:seed"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pg": "^8.12.0"
  }
}
