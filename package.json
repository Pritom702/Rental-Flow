{
  "name": "rentalflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "RentalFlow \u2014 equipment rental marketplace (CSE470). Root manifest used by Vercel to build the client and bundle the API function.",
  "scripts": {
    "build": "npm --prefix client install && npm --prefix client run build",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "test": "npm --prefix server test",
    "db:init": "npm --prefix server run db:init",
    "db:seed": "npm --prefix server run db:seed",
    "db:migrate": "npm --prefix server run db:migrate",
    "db:seed-community": "npm --prefix server run db:seed-community"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@vercel/blob": "^2.8.0",
    "@vladmandic/face-api": "^1.7.15",
    "bcryptjs": "^2.4.3",
    "buffer": "^6.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "jpeg-js": "^0.4.4",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^10.0.10",
    "nsfwjs": "^4.4.0",
    "pg": "^8.12.0",
    "pngjs": "^7.0.0",
    "tesseract.js": "^7.0.0"
  }
}
