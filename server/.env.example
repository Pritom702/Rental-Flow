# Copy this file to .env and adjust if needed
PORT=4000
DATABASE_URL=postgres://rentalflow:rentalflow_dev@localhost:5433/rentalflow
JWT_SECRET=change_this_in_production_rentalflow_secret

# Identity verification emails (6-digit codes). Leave both unset for TEST MODE:
# nothing is sent and the code is shown on screen instead.
# Use a Gmail account with 2-Step Verification on, then create an App Password:
# Google Account > Security > App passwords.
# GMAIL_USER=rentalflow.verify@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
